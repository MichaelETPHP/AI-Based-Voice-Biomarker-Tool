# Copy to .env on the VPS and edit.
# Public domain name pointing (DNS A/AAAA record) to this VPS. HTTPS is automatic.
DOMAIN=voice.example.com
# E-mail for Let's Encrypt certificate notices (required).
ACME_EMAIL=you@example.com

# Performance / limits (sensible defaults for a 2-4 vCPU, 4-8 GB RAM VPS)
TORCH_THREADS=2
APP_MEMORY_LIMIT=4g
MAX_WAITING_ANALYSES=4
RATE_LIMIT_ANALYZE_PER_HOUR=20
RATE_LIMIT_LANGUAGE_PER_HOUR=120

# Public API v1 for other applications (docs at https://DOMAIN/developers/)
# One key per client, "name:key" comma-separated. Generate keys with:  openssl rand -hex 32
# Leave empty to keep the public API disabled (the web app still works).
API_KEYS=
# Optional: browser apps on these origins may call /v1 directly (server-to-server needs nothing)
CORS_ORIGINS=
RATE_LIMIT_API_PER_HOUR=200

# Level thresholds: official (model card config.py) or tuned (backend/thresholds_tuned.json)
DAM_THRESHOLDS=official
